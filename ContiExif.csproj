<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ContiExif</RootNamespace>
    <Version>1.5.1</Version>
    <AssemblyName>ContiExif</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\ContiExif.ico')">Assets\ContiExif.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="MetadataExtractor" Version="2.8.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ContiExif.ico" Condition="Exists('Assets\ContiExif.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PruneLanguageFolders" AfterTargets="Build;Publish">
    <ItemGroup>
      <_Mui Include="$(OutDir)*\*.mui;$(PublishDir)*\*.mui"
            Exclude="$(OutDir)en-US\*.mui;$(PublishDir)en-US\*.mui" />
      <_MuiDirs Include="@(_Mui->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_MuiDirs)" />
  </Target>
</Project>
