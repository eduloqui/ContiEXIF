<Application
    x:Class="ContiExif.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ContiExif accent #00BBCC -->
            <SolidColorBrush x:Key="ContiAccentBrush" Color="#00BBCC" />
            <SolidColorBrush x:Key="ContiAccentHoverBrush" Color="#00A9B8" />
            <SolidColorBrush x:Key="ContiAccentPressedBrush" Color="#0097A4" />
            <SolidColorBrush x:Key="ContiAccentTintBrush" Color="#00BBCC" Opacity="0.30" />
            <SolidColorBrush x:Key="ContiOnAccentBrush" Color="#000000" />

            <Color x:Key="SystemAccentColor">#00BBCC</Color>
            <Color x:Key="SystemAccentColorLight1">#26C6D4</Color>
            <Color x:Key="SystemAccentColorLight2">#4DD0DC</Color>
            <Color x:Key="SystemAccentColorLight3">#80DEE8</Color>
            <Color x:Key="SystemAccentColorDark1">#00A5B5</Color>
            <Color x:Key="SystemAccentColorDark2">#008896</Color>
            <Color x:Key="SystemAccentColorDark3">#006B77</Color>
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="ContiAccentPressedBrush" />

            <!-- Accent button -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="ContiOnAccentBrush" />

            <!-- CheckBox -->
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="ContiOnAccentBrush" />

            <!-- RadioButton -->
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="RadioButtonCheckGlyphFillPressed" ResourceKey="ContiOnAccentBrush" />

            <!-- ToggleButton (checked) -->
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ContiAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ContiAccentHoverBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ContiAccentPressedBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ContiOnAccentBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ContiOnAccentBrush" />

            <!-- ProgressBar -->
            <StaticResource x:Key="ProgressBarForeground" ResourceKey="ContiAccentBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
