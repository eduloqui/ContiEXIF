<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContiExif.Views.DetailPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Width="380" Padding="12" CornerRadius="8" BorderThickness="1"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{StaticResource ContiAccentBrush}">
        <StackPanel Spacing="8">
            <Grid Height="237" Background="#40808080" CornerRadius="4">
                <Image x:Name="Preview" Stretch="Uniform" />
            </Grid>
            <TextBlock x:Name="NameText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" />
            <TextBlock x:Name="PathText" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button Content="Open file" Style="{StaticResource AccentButtonStyle}" Click="OpenFile_Click" />
                <Button Content="Show folder" Click="ShowFolder_Click" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
